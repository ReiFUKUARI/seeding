<Project>

  <!--
    ソリューション全体で共有するビルド設定。

    TargetFramework をここ1か所で管理しているため、.NET のバージョンを
    上げる場合は WindowsTargetFramework の1行と global.json を
    書き換えるだけで全プロジェクトに反映される。

    .NET 10 は LTS（2028年11月まで）。要件定義書 12章は .NET 8/9 を
    挙げているが、いずれもサポート期限が近い／切れているため .NET 10 を採用した。

    WindowsTargetFramework には Windows SDK バージョンを明示的に埋め込んでいる
    （net10.0-windows10.0.26100.0）。バージョンサフィックスなしの
    net10.0-windows と書くと、ビルド時にローカルにインストール済みの
    Windows SDK を自動検出して TargetPlatformVersion を決定する。この自動検出は
    ネイティブWindowsでしか機能せず、Linux（WSL・Dev Container等）では
    検出できず不正な既定値（7.0）にフォールバックし、SupportedOSPlatformVersion
    （各プロジェクトで指定、17763.0）を下回って NETSDK1135 で失敗する。
    バージョンを明示すると、参照アセンブリはNuGetから確定的に解決されるため、
    ホストOSに関わらず同じ結果になる。

    ここでの Windows SDK バージョン（10.0.26100.0）は、あくまで .NET の
    Windows API 参照アセンブリ（NuGetから取得）の話であり、
    packaging/.../.wapproj 側の TargetPlatformVersion（クラシックな
    Windows Kits の UAP プラットフォームSDK。マシンに実際にインストール
    されているバージョンでなければビルドできない）とは本来別物で、
    厳密には値を一致させる必要はない。ただし実機で確認できたのは
    10.0.22621.0 のUAP SDKが未導入で 10.0.26100.0 のみが存在する構成
    だったため、ここでも同じ 10.0.26100.0 に揃えて実機での動作を
    再現しやすくしている（docs/msix-packaging.md 参照）。
  -->
  <PropertyGroup>
    <WindowsTargetFramework>net10.0-windows10.0.26100.0</WindowsTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <Company>営業メール配信アプリ</Company>
    <Product>メール配信ツール</Product>
    <Version>0.1.0</Version>
    <!-- Windows 専用アプリのため、非 Windows 環境向けの警告は抑制する -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    Windows 以外（Linux/macOS）でも net10.0-windows 向けプロジェクト（WPF・DPAPI利用の
    Core を含む）を「コンパイル」できるようにする。.NET SDK は Windows Desktop の
    参照アセンブリをクロスプラットフォームで配布しているため、コード上の誤りを
    検出する目的のビルドはこれで足りる。

    ただし WPF は Windows の UI ランタイムに依存するため、ビルドが通っても
    非Windows環境では実行・起動確認はできない（.wapproj によるMSIX化も同様に
    Windows + MSBuild が必須。docs/msix-packaging.md 参照）。実際の動作確認は
    引き続きWindows実機で行うこと。

    Condition により Windows実機でのビルドには一切影響しない
    （$(OS) が Windows_NT の場合、このプロパティグループごと評価されない）。
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
