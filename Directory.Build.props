<Project>

  <!--
    ソリューション全体で共有するビルド設定。

    TargetFramework をここ1か所で管理しているため、.NET のバージョンを
    上げる場合は WindowsTargetFramework の1行と global.json を
    書き換えるだけで全プロジェクトに反映される。

    .NET 10 は LTS（2028年11月まで）。要件定義書 12章は .NET 8/9 を
    挙げているが、いずれもサポート期限が近い／切れているため .NET 10 を採用した。
  -->
  <PropertyGroup>
    <WindowsTargetFramework>net10.0-windows</WindowsTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <Company>営業メール配信アプリ</Company>
    <Product>メール配信ツール</Product>
    <Version>0.1.0</Version>
    <!-- Windows 専用アプリのため、非 Windows 環境向けの警告は抑制する -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
