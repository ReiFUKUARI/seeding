<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MailDeliveryTool.App</RootNamespace>
    <AssemblyName>MailDeliveryTool</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Windows 11 25H2 が対象（要件定義書 2章）。既定値より下限を明示する -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!--
      MSIXパッケージング（.wapproj）は win-x64 向けにこのプロジェクトを構築するため、
      ランタイムパック（Microsoft.NETCore.App.Runtime.win-x64 等）の復元が必要になる。
      RuntimeIdentifiers（複数形。restore用の宣言）をここで明示しないと、
      .wapproj 側から /restore しても取得されず、後続のビルドで NETSDK1112
      （ランタイムパックが見つからない）になる。
      要件定義書 2章のとおり x64 のみが対象（ARM64は対象外）。
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailDeliveryTool.Core\MailDeliveryTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      アプリアイコン（D-008で確定・採用済み）。存在しない場合でもビルドが止まらないよう
      Condition を付けている。Resourceとして埋め込むことで、Window.Iconからpack URI
      （pack://application:,,,/Assets/app.ico）で参照できるようにする。ApplicationIconは
      .exe自体に埋め込まれるアイコン（デスクトップに置いた場合・タスクバーへのピン留め時に表示）で、
      これとは別にWindow.Icon（実行中ウィンドウのタスクバー表示用）の指定が必要。
    -->
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>

  <PropertyGroup Condition="!Exists('Assets\app.ico')">
    <ApplicationIcon />
  </PropertyGroup>

</Project>
