<UserControl x:Class="MailDeliveryTool.App.Views.ComposeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MailDeliveryTool.App.Controls"
             xmlns:behaviors="clr-namespace:MailDeliveryTool.App.Behaviors">

    <!--
        「新しい配信」ウィザード（要件定義書6〜8章）。宛先選択→メール作成→送信前の確認の
        3ステップを、ComposeViewModel.CurrentStepに応じて1画面ずつ切り替える。
        送信実行（フェーズ5⑥）はまだ未実装で、確認画面の「送信する」はプレースホルダー。

        スクロールはMainWindow側の外側のScrollViewerが担うため、ここには独自の
        ScrollViewerを入れない（設定画面の実機検証で判明した既知の挙動）。
    -->
    <StackPanel Margin="0,0,0,20">

        <!-- ============ ① 宛先選択 ============ -->
        <StackPanel Visibility="{Binding TargetStepVisibility}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="検索" FontWeight="SemiBold" FontSize="15" />
                        <Button Grid.Column="1" Content="条件をクリア" Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding ClearFiltersCommand}" />
                    </Grid>

                    <!-- mock_prototype.htmlのfilter-panel（display:flex; gap:40px; flex-wrap:wrap）に合わせ、
                         キーワード・種別・技術領域を横並びにする。WrapPanelにするのは、画面幅が
                         足りないときに折り返して、ウィンドウのリサイズに追従させるため
                         （横並び用のStackPanelは折り返さず幅がアジャストしないため使わない）。 -->
                    <WrapPanel>
                        <StackPanel Margin="0,0,40,10" MinWidth="220">
                            <TextBlock Text="キーワード（会社名・担当者名・メモ）" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlaceholderTextBoxStyle}" Tag="部分一致で検索"
                                     Width="220" HorizontalAlignment="Left" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FilterAxes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,40,10" MinWidth="160">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                        <!-- 値が7件以上になっても、1行に6つまでで折り返す -->
                                        <ItemsControl ItemsSource="{Binding Values}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Value.Name}" IsChecked="{Binding IsSelected}"
                                                              Margin="0,0,14,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Margin="0,0,4,0"
                                Command="{Binding SwitchToSearchTabCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="すべて" VerticalAlignment="Center" />
                                <!-- 件数バッジ（mock_prototype.htmlの.tab-count相当。選択中タブではアクセントカラーになる） -->
                                <Border CornerRadius="9" Padding="8,1" Margin="6,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0EFED" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchTabActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SearchCountText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSearchTabActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchToListTabCommand}"
                                IsEnabled="{Binding HasMailingListItems}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="メールリスト" VerticalAlignment="Center" />
                                <Border CornerRadius="9" Padding="8,1" Margin="6,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0EFED" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsListTabActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ListCountText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListTabActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- すべてタブ -->
                    <StackPanel Visibility="{Binding SearchTabVisibility}">
                        <CheckBox Content="すべて選択/解除" IsChecked="{Binding IsAllSearchChecked}" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" CanUserReorderColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                                  Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1" HorizontalGridLinesBrush="{StaticResource BorderBrush}" MaxHeight="360"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="False" EnableColumnVirtualization="False"
                                  behaviors:HorizontalMouseWheelBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <!-- DataGridCellが最初のクリックでセル選択にフォーカスを奪い、
                                         チェックボックスへのクリックが1回目は届かなくなるのを防ぐ -->
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="会社名" Width="1.4*" MinWidth="100" IsReadOnly="True"
                                                     Binding="{Binding Contact.CompanyName, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.CompanyName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="担当者名" Width="*" MinWidth="90" IsReadOnly="True"
                                                     Binding="{Binding Contact.ContactName, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.ContactName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="メールアドレス" Width="1.6*" MinWidth="130" IsReadOnly="True"
                                                     Binding="{Binding Contact.Email, Converter={StaticResource TruncateTextConverter}, ConverterParameter=15}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.Email}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="種別" Width="*" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CategoryChipList Items="{Binding TypeCategoryNames}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="技術領域" Width="*" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CategoryChipList Items="{Binding TechFieldCategoryNames}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="メモ" Width="1.2*" MinWidth="90" IsReadOnly="True"
                                                     Binding="{Binding Contact.Memo, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.Memo}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="メールリストに追加" Command="{Binding AddCheckedToListCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- メールリストタブ -->
                    <StackPanel Visibility="{Binding ListTabVisibility}">
                        <CheckBox Content="すべて選択/解除" IsChecked="{Binding IsAllListChecked}" Margin="0,0,0,8" />
                        <!-- 削除ボタン列はmock_prototype.htmlと同じく右端（元の位置）に置く。誤操作を避けるため
                             左側への固定（FrozenColumnCount）はしない。横スクロールで最後まで確実に
                             到達できるよう、幅をAutoではなく固定値にしている（Autoだと横スクロールの
                             最大幅の計算に含まれず、右端までスクロールしても見えないことがあったため）。 -->
                        <DataGrid ItemsSource="{Binding MailingList}" AutoGenerateColumns="False" CanUserReorderColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                                  Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1" HorizontalGridLinesBrush="{StaticResource BorderBrush}" MaxHeight="360"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="False" EnableColumnVirtualization="False"
                                  behaviors:HorizontalMouseWheelBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <!-- DataGridCellが最初のクリックでセル選択にフォーカスを奪い、
                                         チェックボックスへのクリックが1回目は届かなくなるのを防ぐ -->
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="会社名" Width="1.4*" MinWidth="100" IsReadOnly="True"
                                                     Binding="{Binding Contact.CompanyName, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.CompanyName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="担当者名" Width="*" MinWidth="90" IsReadOnly="True"
                                                     Binding="{Binding Contact.ContactName, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.ContactName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="メールアドレス" Width="1.6*" MinWidth="130" IsReadOnly="True"
                                                     Binding="{Binding Contact.Email, Converter={StaticResource TruncateTextConverter}, ConverterParameter=15}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.Email}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="種別" Width="*" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CategoryChipList Items="{Binding TypeCategoryNames}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="技術領域" Width="*" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CategoryChipList Items="{Binding TechFieldCategoryNames}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="メモ" Width="1.2*" MinWidth="90" IsReadOnly="True"
                                                     Binding="{Binding Contact.Memo, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Contact.Memo}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    ToolTip="リストから削除" Margin="2"
                                                    Style="{StaticResource DangerIconButtonStyle}"
                                                    Command="{Binding DataContext.RemoveFromListCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="確定する" Command="{Binding ConfirmTargetCommand}"
                                    IsEnabled="{Binding CanConfirmTarget}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ ② メール作成 ============ -->
        <StackPanel Visibility="{Binding ComposeStepVisibility}">
            <Button Content="← 宛先の選択に戻る" Command="{Binding GoBackToTargetCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    HorizontalAlignment="Left" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="件名" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" Tag="件名を入力" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="本文" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="🏷 タグを挿入 ▾" Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnInsertTagButtonClick">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="#会社名#" Command="{Binding InsertTagCommand}" CommandParameter="会社名" />
                                        <MenuItem Header="#担当者名#" Command="{Binding InsertTagCommand}" CommandParameter="担当者名" />
                                        <MenuItem Header="#メールアドレス#" Command="{Binding InsertTagCommand}" CommandParameter="メールアドレス" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="220" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Yu Gothic UI" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding BodyErrorText}" Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="#FAF9F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SignatureNoteText}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="添付ファイル（複数可・合計13MBまで）" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,5" />
                        <Border BorderBrush="#C8C6C4" BorderThickness="1.5" CornerRadius="8" Padding="16"
                                Background="Transparent" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding AddAttachmentCommand}" />
                            </Border.InputBindings>
                            <TextBlock Text="クリックしてファイルを選択" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAF9F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}" FontSize="12.5" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SizeText, StringFormat=' （{0}）'}" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    ToolTip="添付を削除"
                                                    Style="{StaticResource DangerIconButtonStyle}"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AttachmentErrorText}" Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="宛先" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding TargetCountText}" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="件に送信します" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                            <TextBlock Text="{Binding TargetErrorText}" Foreground="{StaticResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="プレビュー（1件目）" FontWeight="SemiBold" FontSize="12.5" />
                                <!-- 記号が小さく分かりづらいとの指摘のため、アイコンボタン既定より大きく太字にする -->
                                <Button Grid.Column="1" Content="⤢" ToolTip="クリックで拡大表示"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="32" Height="32" FontSize="19" FontWeight="Bold"
                                        Command="{Binding OpenPreviewModalCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" MaxHeight="220" />
                        </StackPanel>
                    </Border>
                    <Button Content="確認する" Command="{Binding CheckAndProceedCommand}"
                            HorizontalAlignment="Stretch" Padding="0,10"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ============ ③ 送信前の確認 ============ -->
        <StackPanel Visibility="{Binding ConfirmationStepVisibility}">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" MaxWidth="760" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="送信内容" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <TextBlock FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6">
                        <Run Text="宛先一覧（" /><Run Text="{Binding TargetCountText, Mode=OneWay}" /><Run Text="件）" />
                    </TextBlock>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                            MaxHeight="200" Margin="0,0,0,14">
                        <DataGrid ItemsSource="{Binding ConfirmTargetRows}" AutoGenerateColumns="False" CanUserReorderColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="{StaticResource SurfaceBrush}" BorderThickness="0" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="会社名" Binding="{Binding CompanyName}" Width="1.4*" />
                                <DataGridTextColumn Header="担当者名" Binding="{Binding ContactName}" Width="*" />
                                <DataGridTextColumn Header="メールアドレス" Binding="{Binding Email}" Width="1.6*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="件名" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding ConfirmSubjectText}" FontWeight="SemiBold" Margin="0,2,0,14" />

                    <TextBlock Text="本文" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                    <Border Background="#FAF9F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" MaxHeight="260" Margin="0,0,0,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ConfirmBodyText}" TextWrapping="Wrap" FontSize="12.5" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="添付ファイル" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ConfirmAttachmentsText}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Border Background="#FFF8E1" BorderBrush="#F0DC82" BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasDuplicateWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding ConfirmDuplicateWarningText}" TextWrapping="Wrap"
                                   Foreground="#8A6D00" FontSize="12.5" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="戻る" Command="{Binding BackToComposeCommand}" Margin="0,0,8,0" Padding="14,6" />
                        <Button Content="送信する" Command="{Binding StartSendingCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ ④ 送信中 ============ -->
        <StackPanel Visibility="{Binding SendingStepVisibility}" MaxWidth="480" HorizontalAlignment="Center" Margin="0,60,0,0">
            <TextBlock Text="送信しています…" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,14" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                         Height="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />
            <Border Background="#FAF9F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Height="140">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProgressLogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas, Yu Gothic UI" FontSize="11.5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- ============ ⑤ 送信結果 ============ -->
        <StackPanel Visibility="{Binding ResultStepVisibility}">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SuccessCount}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="送信成功" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FailCount}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="送信失敗" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="送信失敗の宛先一覧" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- コピー完了の一時的な案内（mock_prototype.htmlのcopyToast相当） -->
                            <Border Background="{StaticResource TextPrimaryBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0"
                                    Visibility="{Binding IsCopyToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="失敗一覧をクリップボードにコピーしました" Foreground="White" FontSize="12" />
                            </Border>
                            <Button Content="📋 一覧をコピー" Command="{Binding CopyFailListCommand}"
                                    Padding="10,4" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding FailedResults}" AutoGenerateColumns="False" CanUserReorderColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1" HorizontalGridLinesBrush="{StaticResource BorderBrush}" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="会社名" Binding="{Binding Contact.CompanyName}" Width="1.2*" />
                            <DataGridTextColumn Header="担当者名" Binding="{Binding Contact.ContactName}" Width="*" />
                            <DataGridTextColumn Header="メールアドレス" Binding="{Binding Contact.Email}" Width="1.4*" />
                            <DataGridTextColumn Header="エラー内容" Binding="{Binding ErrorMessage}" Width="1.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="完了する" Command="{Binding FinishSendingCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
