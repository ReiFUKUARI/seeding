<Window x:Class="MailDeliveryTool.App.Views.ContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宛先を追加"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Background="{StaticResource CanvasBrush}">

    <!-- 要件定義書5.1：会社名・担当者名・メールアドレスは必須（フォーム側で担保。DB制約にはしていない） -->
    <StackPanel Margin="20">
        <TextBlock Text="会社名" Margin="0,0,0,4" />
        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="担当者名" Margin="0,0,0,4" />
        <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="メールアドレス" Margin="0,0,0,4" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="メモ（任意・100文字まで）" Margin="0,0,0,4" />
        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,14" />

        <!-- カテゴリはCategoryStore由来（D-003）。追加・削除するとこのモーダルにも即時反映される -->
        <ItemsControl ItemsSource="{Binding CategoryAxes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Values}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Value.Name}" IsChecked="{Binding IsSelected}"
                                              Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="キャンセル" Click="OnCancelClick" Margin="0,0,8,0" Padding="14,6" />
            <Button x:Name="SaveButton" Content="登録する" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
