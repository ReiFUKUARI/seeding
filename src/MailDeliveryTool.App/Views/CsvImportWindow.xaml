<Window x:Class="MailDeliveryTool.App.Views.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSVから取り込む"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Background="{StaticResource CanvasBrush}">

    <!-- パートナーリストのCSV取込モーダル（mock_prototype.htmlのcsvImportModal相当） -->
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" FontSize="12.5"
                   Text="既存のカテゴリ値（種別・技術領域）に存在しない値が含まれる場合はエラーとして取込を停止します。" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" FontSize="12.5"
                   Text="現在登録されている種別・技術領域の選択肢に対応したフォーマットをダウンロードできます。" />

        <Button Content="フォーマットをダウンロード" HorizontalAlignment="Left" Margin="0,0,0,14"
                Command="{Binding DownloadTemplateCommand}" />

        <Border BorderBrush="#C8C6C4" BorderThickness="1.5" CornerRadius="8" Padding="16"
                Background="Transparent" Cursor="Hand">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectFileCommand}" />
            </Border.InputBindings>
            <TextBlock Text="クリックしてCSVファイルを選択" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
        </Border>

        <TextBlock Text="{Binding SelectedFileText}" Margin="0,8,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
        <TextBlock Text="{Binding ResultText}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12.5" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="閉じる" Click="OnCloseClick" Margin="0,0,8,0" Padding="14,6" />
            <Button Content="取り込む" Padding="14,6"
                    Command="{Binding RunImportCommand}"
                    IsEnabled="{Binding CanImport}"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </StackPanel>
</Window>
