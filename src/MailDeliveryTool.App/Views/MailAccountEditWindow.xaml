<Window x:Class="MailDeliveryTool.App.Views.MailAccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メールアカウントを変更"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Background="{StaticResource CanvasBrush}">

    <!-- 要件定義書10.1：パスワードは変更する場合のみ入力する -->
    <StackPanel Margin="20">
        <TextBlock Text="サーバー名" Margin="0,0,0,4" />
        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="アカウント名" Margin="0,0,0,4" />
        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="パスワード（変更する場合のみ入力）" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,12" PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="ポート" Margin="0,0,0,4" />
        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="暗号化方法" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding SecureSocketOptions}"
                  SelectedItem="{Binding SecureSocketOption}" Margin="0,0,0,12" />

        <TextBlock Text="送信元アドレス" Margin="0,0,0,4" />
        <TextBox Text="{Binding FromAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="送信者名（任意）" Margin="0,0,0,4" />
        <TextBox Text="{Binding FromDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Click="OnCancelClick" Margin="0,0,8,0" Padding="14,6" />
            <Button Content="保存" Click="OnSaveClick" Padding="14,6"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </StackPanel>
</Window>
