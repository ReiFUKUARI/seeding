<Window x:Class="MailDeliveryTool.App.Views.MailAccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メールアカウントを変更"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Background="{StaticResource CanvasBrush}">

    <!-- 要件定義書10.1：パスワードは変更する場合のみ入力する。
         送信者名以外は必須項目とし、赤い*で明示する。 -->
    <StackPanel Margin="20">
        <TextBlock Margin="0,0,0,4">
            <Run Text="サーバー名" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" />
        </TextBlock>
        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Margin="0,0,0,4">
            <Run Text="アカウント名" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" />
        </TextBlock>
        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Margin="0,0,0,4">
            <Run Text="パスワード（変更する場合のみ入力）" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" />
        </TextBlock>
        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,12" PasswordChanged="OnPasswordChanged" />

        <TextBlock Margin="0,0,0,4">
            <Run Text="ポート" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" />
        </TextBlock>
        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Margin="0,0,0,4">
            <Run Text="暗号化方法" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" />
        </TextBlock>
        <ComboBox ItemsSource="{Binding SecureSocketOptions}"
                  DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding SecureSocketOption}" Margin="0,0,0,12" />

        <TextBlock Margin="0,0,0,4">
            <Run Text="送信元アドレス" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" />
        </TextBlock>
        <TextBox Text="{Binding FromAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="送信者名（任意）" Margin="0,0,0,4" />
        <TextBox Text="{Binding FromDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Click="OnCancelClick" Margin="0,0,8,0" Padding="14,6" />
            <Button Content="保存する" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
