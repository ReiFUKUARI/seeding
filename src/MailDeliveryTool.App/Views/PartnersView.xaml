<UserControl x:Class="MailDeliveryTool.App.Views.PartnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MailDeliveryTool.App.Controls">

    <!--
        パートナーリスト画面（要件定義書5章）。検索・一覧・登録・停止/再開を1画面に統合する。

        スクロールはMainWindow側の外側のScrollViewerが担う。ここに独自のScrollViewerを
        入れると、WPFの仕様上マウスホイールが外側へ伝播しなくなる（設定画面の実機検証で
        判明した既知の挙動）ため、このUserControl自体はスクロールしないこと。
    -->
    <StackPanel Margin="0,0,0,20">

        <!-- 検索（キーワードは会社名・担当者名・メモを横断。カテゴリは軸内OR・軸間AND） -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="検索" FontWeight="SemiBold" FontSize="15" />
                    <Button Grid.Column="1" Content="条件をクリア" Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding ClearFiltersCommand}" />
                </Grid>

                <!-- mock_prototype.htmlのfilter-panel（display:flex; gap:40px; flex-wrap:wrap）に合わせ、
                     キーワード・種別・技術領域を横並びにする。WrapPanelにするのは、画面幅が
                     足りないときに折り返して、ウィンドウのリサイズに追従させるため
                     （横並び用のStackPanelは折り返さず幅がアジャストしないため使わない）。 -->
                <WrapPanel>
                    <StackPanel Margin="0,0,40,10" MinWidth="220">
                        <TextBlock Text="キーワード（会社名・担当者名・メモ）" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlaceholderTextBoxStyle}" Tag="部分一致で検索"
                                 Width="220" HorizontalAlignment="Left" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding FilterAxes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,40,10" MinWidth="160">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                    <!-- 値が7件以上になっても、1行に6つまでで折り返す -->
                                    <ItemsControl ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value.Name}" IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,14,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 一覧 -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ResultCountText}"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Content="追加する" Command="{Binding OpenAddContactCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />

                    <Button Grid.Column="2" Content="CSVから取り込む" Command="{Binding OpenCsvImportCommand}" />
                </Grid>

                <!-- 列は幅に応じて伸縮しつつ、MinWidthを下回る幅では横スクロールする。
                     縦方向はMaxHeightを超えると一覧自体が縦スクロールする。
                     「操作」列はmock_prototype.htmlと同じく右端（元の位置）に置く。誤操作を避けるため
                     左側への固定（FrozenColumnCount）はしない。横スクロールで最後まで確実に
                     到達できるよう、幅をAutoではなく固定値にしている（Autoだと横スクロールの
                     最大幅の計算に含まれず、右端までスクロールしても見えないことがあったため）。 -->
                <DataGrid ItemsSource="{Binding Contacts}"
                          AutoGenerateColumns="False" CanUserReorderColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="34"
                          MaxHeight="480"
                          EnableRowVirtualization="False"
                          EnableColumnVirtualization="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                    <!--
                        停止中の行は該当セルだけ薄く表示する（mock_prototype.htmlの.row-suspended-cell相当）。
                        DataGridRow.Opacityで行全体を下げると、停止中でも操作可能な「再開」ボタンまで
                        薄く見えて押せるように見えなくなるため、データ列のみCellStyleで個別に下げ、
                        「操作」列のボタンは常に通常表示のままにする。
                    -->
                    <DataGrid.Resources>
                        <Style x:Key="SuspendedDimCellStyle" TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Contact.IsSuspended}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="会社名" Width="1.4*" MinWidth="160"
                                             Binding="{Binding Contact.CompanyName, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}"
                                             CellStyle="{StaticResource SuspendedDimCellStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Contact.CompanyName}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="担当者名" Width="*" MinWidth="100"
                                             Binding="{Binding Contact.ContactName, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}"
                                             CellStyle="{StaticResource SuspendedDimCellStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Contact.ContactName}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="メールアドレス" Width="1.6*" MinWidth="180"
                                             Binding="{Binding Contact.Email, Converter={StaticResource TruncateTextConverter}, ConverterParameter=15}"
                                             CellStyle="{StaticResource SuspendedDimCellStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Contact.Email}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="種別" Width="*" MinWidth="110" CellStyle="{StaticResource SuspendedDimCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CategoryChipList Items="{Binding TypeCategoryNames}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="技術領域" Width="*" MinWidth="110" CellStyle="{StaticResource SuspendedDimCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CategoryChipList Items="{Binding TechFieldCategoryNames}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="メモ" Width="1.2*" MinWidth="110"
                                             Binding="{Binding Contact.Memo, Converter={StaticResource TruncateTextConverter}, ConverterParameter=10}"
                                             CellStyle="{StaticResource SuspendedDimCellStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Contact.Memo}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✎" ToolTip="編集" Style="{StaticResource IconButtonStyle}"
                                                Margin="2" IsEnabled="{Binding Contact.IsSuspended, Converter={StaticResource InverseBooleanConverter}}"
                                                Command="{Binding DataContext.EditContactCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding ToggleGlyph}" ToolTip="{Binding ToggleTooltip}" Margin="2"
                                                Command="{Binding DataContext.ToggleSuspendCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerIconButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Contact.IsSuspended}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
