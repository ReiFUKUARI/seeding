<UserControl x:Class="MailDeliveryTool.App.Views.PartnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        パートナーリスト画面（要件定義書5章）。検索・一覧・登録・停止/再開を1画面に統合する。

        スクロールはMainWindow側の外側のScrollViewerが担う。ここに独自のScrollViewerを
        入れると、WPFの仕様上マウスホイールが外側へ伝播しなくなる（設定画面の実機検証で
        判明した既知の挙動）ため、このUserControl自体はスクロールしないこと。
    -->
    <StackPanel Margin="0,0,0,20">

        <!-- 検索（キーワードは会社名・担当者名・メモを横断。カテゴリは軸内OR・軸間AND） -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="検索" FontWeight="SemiBold" Margin="0,0,0,10" />

                <TextBlock Text="キーワード（会社名・担当者名・メモ）" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Width="280" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding FilterAxes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Values}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Value.Name}" IsChecked="{Binding IsSelected}"
                                                      Margin="0,0,14,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="条件をクリア" HorizontalAlignment="Left"
                        Style="{StaticResource SubtleButtonStyle}"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
        </Border>

        <!-- 一覧 -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ResultCountText}"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Content="CSVから取り込む" Command="{Binding OpenCsvImportCommand}"
                            Margin="0,0,8,0" Padding="14,6" />

                    <Button Grid.Column="2" Content="宛先を追加" Command="{Binding OpenAddContactCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <DataGrid ItemsSource="{Binding Contacts}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="34"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="会社名" Binding="{Binding Contact.CompanyName}" Width="1.4*" />
                        <DataGridTextColumn Header="担当者名" Binding="{Binding Contact.ContactName}" Width="*" />
                        <DataGridTextColumn Header="メールアドレス" Binding="{Binding Contact.Email}" Width="1.6*" />
                        <DataGridTextColumn Header="種別" Binding="{Binding TypeCategoryText}" Width="*" />
                        <DataGridTextColumn Header="技術領域" Binding="{Binding TechFieldCategoryText}" Width="*" />
                        <DataGridTextColumn Header="メモ" Binding="{Binding Contact.Memo}" Width="1.2*" />
                        <DataGridTextColumn Header="状態" Binding="{Binding StatusText}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Contact.IsSuspended}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Contact.IsSuspended}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="操作" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ToggleLabel}" Padding="10,3" Margin="4,2"
                                            Command="{Binding DataContext.ToggleSuspendCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
