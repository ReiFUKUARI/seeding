<UserControl x:Class="MailDeliveryTool.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        設定画面（要件定義書10章）。メールアカウント／バックアップ／カテゴリ管理の
        3セクションを1画面に統合する。カテゴリ一覧は SettingsViewModel.Axes 経由で
        CategoryStore（App全体の単一の共有ストア。D-003）を参照している。

        スクロールは MainWindow 側の外側の ScrollViewer が担う。ここに独自の
        ScrollViewer を入れると、WPFの仕様上マウスホイールが外側へ伝播しなくなる
        （ネストしたScrollViewerがホイールイベントを飲み込む既知の挙動）ため、
        このUserControl自体はスクロールしないこと。
    -->
        <StackPanel Margin="0,0,0,20">

            <!-- メールアカウント（要件定義書10.1） -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="メールアカウント" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="サーバー名"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccountServerText}" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="アカウント名"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccountNameText}" Margin="0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ポート"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccountPortText}" Margin="0,4" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="暗号化方法"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccountEncryptionText}"
                                   TextWrapping="Wrap" Margin="0,4" />
                    </Grid>

                    <Button Content="変更する" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding ChangeMailAccountCommand}" />
                </StackPanel>
            </Border>

            <!-- バックアップ（要件定義書5.5・10.2） -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="バックアップ" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="宛先リストをCSV形式でバックアップします。起動時に前回の実行から7日以上経過していれば自動的に実行されます。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="保存先"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BackupFolderText}"
                                   TextWrapping="Wrap" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最終実行"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastBackupText}" Margin="0,4" />
                    </Grid>

                    <Button Content="今すぐバックアップする" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding RunBackupCommand}"
                            IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBooleanConverter}}" />

                    <TextBlock Text="{Binding BackupStatusText}" Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- カテゴリ管理（要件定義書5.3・10.3） -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="カテゴリ管理" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- 種別軸 -->
                    <TextBlock Text="{Binding TypeAxis.Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding TypeAxis.Values}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F4" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" />
                                        <Button Content="×" Margin="6,0,0,0" Padding="4,0" BorderThickness="0"
                                                Background="Transparent" FontSize="12"
                                                ToolTip="削除"
                                                Command="{Binding DataContext.DeleteCategoryValueCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,18">
                        <TextBox Width="160" Text="{Binding NewTypeValueName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="追加" Margin="6,0,0,0" Command="{Binding AddTypeValueCommand}" />
                    </StackPanel>

                    <!-- 技術領域軸 -->
                    <TextBlock Text="{Binding TechFieldAxis.Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding TechFieldAxis.Values}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F4" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" />
                                        <Button Content="×" Margin="6,0,0,0" Padding="4,0" BorderThickness="0"
                                                Background="Transparent" FontSize="12"
                                                ToolTip="削除"
                                                Command="{Binding DataContext.DeleteCategoryValueCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="160" Text="{Binding NewTechFieldValueName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="追加" Margin="6,0,0,0" Command="{Binding AddTechFieldValueCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
</UserControl>
