<Window x:Class="MailDeliveryTool.App.Views.TextPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Background="{StaticResource CanvasBrush}">

    <!-- 本文プレビューの拡大表示モーダル（メール作成画面の「クリックで拡大表示」相当） -->
    <DockPanel Margin="22,20">
        <TextBlock x:Name="TitleTextBlock" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,14" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BodyTextBlock" TextWrapping="Wrap" LineHeight="26" FontSize="15" />
        </ScrollViewer>
    </DockPanel>
</Window>
