<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      DPAPI（ProtectedData）を利用するため Windows 向け TFM を指定する。
      UI には依存しないため、WPF（UseWPF）は参照しない。
    -->
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <RootNamespace>MailDeliveryTool.Core</RootNamespace>
    <AssemblyName>MailDeliveryTool.Core</AssemblyName>
    <!--
      MSIXパッケージング（.wapproj）はwin-x64向けにApp経由でこのプロジェクトも
      構築するため、ランタイムパックの復元が必要になる（App.csprojにも同様の
      設定あり）。ProjectReference越しにApp側だけ宣言してもrestoreが正しく
      連鎖せず NETSDK1112 になったため、参照グラフに含まれる各プロジェクトに
      明示している。
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- CSVバックアップ書き出し（Backup/ContactCsvExporter）用。要件定義書5.5・10.2 -->
    <PackageReference Include="CsvHelper" />
    <!--
      System.Text.Encoding.CodePages はCSV取込（Shift-JISフォールバック読み込み）まで
      未参照のため、ここにはまだ追加しない。バージョンは Directory.Packages.props に
      残してあるので、実装時は <PackageReference Include="..." /> の1行を足すだけでよい。
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- スキーマ DDL は埋め込みリソースとして持ち、初回起動時に実行する -->
    <EmbeddedResource Include="Data\Schema\Schema_v1.sql" />
    <EmbeddedResource Include="Data\Schema\Seed_v1.sql" />
  </ItemGroup>

</Project>
